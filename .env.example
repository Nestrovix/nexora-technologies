# ---------------------------------------------------------------------------
# Nexora Technologies — environment variables
# Copy to .env.local for development, and add the same keys in the Vercel
# project settings for preview/production. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap.xml, robots.txt and
# Open Graph metadata. The only variable that is safe to expose to the browser.
NEXT_PUBLIC_SITE_URL="https://www.your-domain.com"

# --- Enquiry delivery (choose one; wire it up in src/app/api/enquiry/route.ts)
# Transactional email
# RESEND_API_KEY=""
# ENQUIRY_TO_EMAIL="sales@your-domain.com"
# ENQUIRY_FROM_EMAIL="website@your-domain.com"

# CRM
# CRM_API_KEY=""
# CRM_PIPELINE_ID=""

# Database
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Resume storage for job applications (src/app/api/apply/route.ts)
# BLOB_READ_WRITE_TOKEN=""
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- Optional: shared rate-limit store (replaces the in-memory limiter)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Optional analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
